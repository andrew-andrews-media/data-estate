        "@language": "en",
        "@value": "Ruling"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A question put to the owner for a decision, on a rulings sheet or the decision board, with the answer once given."
      }
    },
    {
      "@id": "de:Tenant",
      "@type": "owl:Class",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Tenant"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Agent"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The person or organisation a repository is kept for."
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Tenants name people and organisations, so a publication of an estate lists none."
      }
    },
    {
      "@id": "de:Topic",
      "@type": "owl:Class",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Topic"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A subject that documents concern, other than an organisation, event, framework, place or person."
      }
    },
    {
      "@id": "de:aboutRepository",
      "@type": "owl:ObjectProperty",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
