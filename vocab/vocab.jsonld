        "@id": "https://w3id.org/data-estate/scheme/type"
      },
      "skos:notation": "register",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Register"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/data-estate/scheme/type"
      }
    },
    {
      "@id": "https://w3id.org/data-estate/type/report",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A document that sets out findings or analysis."
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/data-estate/scheme/type"
      },
      "skos:notation": "report",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Report"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/data-estate/scheme/type"
      }
    },
    {
      "@id": "https://w3id.org/data-estate/type/template",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A form that other documents are made from."
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/data-estate/scheme/type"
      },
      "skos:notation": "template",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Template"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/data-estate/scheme/type"
      }
    },
    {
      "@id": "https://w3id.org/data-estate/vocab",
      "@type": "owl:Ontology",
      "dcterms:creator": {
        "@id": "_:cb0"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "The Data Estate Ontology describes a data estate: the repositories a person or small organisation keeps, the documents in them, and the control plane that governs them. It was built for one working estate, and is published so that others can describe theirs the same way."
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-10-27"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Data Estate Ontology"
      },
      "owl:versionIRI": {
        "@id": "https://w3id.org/data-estate/vocab/2026-10-27"
      },
      "owl:versionInfo": "1.0",
      "rdfs:comment": {
        "@language": "en",
        "@value": "In these definitions, a matter is an action or question the owner owes; a rulings sheet is a dated list of questions put to the owner; the decision board is where the owner answers matters and rulings, each answer filed back into the estate; the register is the estate's list of its repositories, and the entity register its list of the entities documents may name; a metadata block is the short block of keys at the head of a document; the catalogue is the index of every artefact, built from those blocks and from where files sit; and a lineage file is a repository's own record of its significant changes. Every organisation, community, event, framework, topic, place and person in the entity register is also a skos:Concept in the estate's own entity scheme, which a publication does not include: its concepts are names."
      },
      "rdfs:seeAlso": [
        {
          "@id": "https://w3id.org/data-estate/docs/"
        },
        {
          "@id": "https://w3id.org/data-estate/shapes"
        }
      ],
      "vann:preferredNamespacePrefix": "de",
      "vann:preferredNamespaceUri": "https://w3id.org/data-estate/vocab#"
    },
    {
      "@id": "org:subOrganizationOf",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "An entity is a subsidiary, unit, region or community of the other."
      }
    },
    {
      "@id": "prov:wasDerivedFrom",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The canonical copy that a copy of an artefact derives from."
      }
    },
    {
      "@id": "schema:Event",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "An event that documents concern."
      }
    },
    {
      "@id": "schema:Organization",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "An organisation that documents concern."
      }
    },
    {
      "@id": "schema:Person",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "A person that documents concern. People are names only, and are never related to another entity."
      }
    },
    {
      "@id": "schema:Place",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "A place that documents concern."
      }
    },
    {
      "@id": "schema:mentions",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "An entity that a matter's source names."
      }
    },
    {
      "@id": "schema:organizer",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The organisation or community that organises an event."
      }
    },
    {
      "@id": "skos:altLabel",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Another name an entity goes by."
      }
    },
    {
      "@id": "skos:notation",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "An entity's slug, or a concept's code: a short key that never changes."
      }
    },
    {
      "@id": "skos:prefLabel",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "An entity's or concept's name."
      }
    }
  ]
}
