        "@id": "de:LineageEntry"
      },
      "schema:rangeIncludes": {
        "@id": "de:Repository"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The repository a lineage entry's change was made to."
      }
    },
    {
      "@id": "de:alsoId",
      "@type": "owl:DatatypeProperty",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
