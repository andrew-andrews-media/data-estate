        "@language": "en",
        "@value": "Deliverable"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A piece of planned work, open until it is delivered or dropped, with its evidence."
      }
    },
    {
      "@id": "de:Framework",
      "@type": "owl:Class",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Framework"
      },
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A published framework, standard, programme or publication."
      }
    },
    {
      "@id": "de:Job",
