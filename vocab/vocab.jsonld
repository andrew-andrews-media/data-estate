        "@language": "en",
        "@value": "Non-sensitive repository"
      },
      "rdfs:subClassOf": {
        "@id": "de:Repository"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A repository not flagged sensitive, and so described in full."
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Every non-sensitive repository is also a data product (dprod:DataProduct)."
      }
    },
    {
      "@id": "de:Project",
      "@type": "owl:Class",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Project"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A workspace where a body of work is carried on, such as a project in an AI assistant, kept on record by a repository."
      }
    },
    {
      "@id": "de:Question",
      "@type": "owl:Class",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Question"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A ruling, question or go-ahead the owner owes, outside a rulings sheet."
      }
    },
    {
      "@id": "de:Repository",
      "@type": "owl:Class",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Repository"
      },
      "rdfs:subClassOf": {
        "@id": "dcat:Catalog"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A top-level body of work, registered as a unit. From T1 it keeps its own record of what was asked, produced and decided."
      }
    },
    {
      "@id": "de:Ruling",
      "@type": "owl:Class",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
