        "@language": "en",
        "@value": "Lineage entry"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A record that a significant change was made to a repository: its date, its kind and its evidence."
      }
    },
    {
      "@id": "de:NonSensitiveRepository",
      "@type": "owl:Class",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
