    },
    {
      "@id": "https://w3id.org/data-estate/tier/t1",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Registered with a known owner and purpose; kept in the standard layout, with a README and a decision log. Version control comes at T2."
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/data-estate/scheme/tier"
      },
      "skos:notation": "T1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Registered"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/data-estate/scheme/tier"
      }
    },
    {
      "@id": "https://w3id.org/data-estate/tier/t2",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Also under version control, with a remote copy, so every change can be reviewed and reverted. No credential may ever have entered its history, and confidential client material is either absent or the remote is private."
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/data-estate/scheme/tier"
      },
      "skos:notation": "T2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Versioned"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/data-estate/scheme/tier"
      }
    },
    {
      "@id": "https://w3id.org/data-estate/tier/t3",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Also runs something: a service, a timer or a container. It needs pinned dependencies, a way to deploy and a stated backup position."
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/data-estate/scheme/tier"
      },
      "skos:notation": "T3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Runtime"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/data-estate/scheme/tier"
