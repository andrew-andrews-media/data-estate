  "@graph": [
    {
      "@id": "_:cb0",
      "@type": "schema:Person",
      "schema:name": "Andrew Andrews",
      "schema:url": {
        "@id": "https://github.com/andrew-andrews-media"
      }
    },
    {
      "@id": "dcterms:date",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "An artefact's own date, not the day it was filed; when a lineage entry's change was made; a decision's date; for a ruling from the decision board, when the owner answered."
      }
    },
    {
      "@id": "dcterms:isPartOf",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The repository that holds an artefact."
      }
    },
    {
      "@id": "dcterms:publisher",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The organisation or community that publishes a framework."
      }
    },
    {
      "@id": "dcterms:replaces",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The earlier version an artefact supersedes; an earlier answer to the same matter that a ruling replaces."
      }
    },
    {
      "@id": "dcterms:subject",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "An entity an artefact concerns."
      }
    },
    {
      "@id": "dcterms:title",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "A repository's name; an artefact's title; a decision's or ruling's first bold phrase, else its first sentence; what a matter or deliverable asks to be done, answered or delivered."
      }
    },
    {
      "@id": "de:Action",
      "@type": "owl:Class",
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/data-estate/vocab"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Action"
      },
      "rdfs:subClassOf": {
        "@id": "schema:Action"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Something only the owner can do, tracked until it is done or dropped."
      }
    },
    {
      "@id": "de:Artefact",
      "@type": "owl:Class",
      "rdfs:isDefinedBy": {
